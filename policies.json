    "rd_staff_ratio": { "label": "研发人员占比", "type": "number", "unit": "%", "group": "研发与资质", "min": 0, "max": 100 },
    "high_tech": { "label": "是否高新技术企业", "type": "bool", "group": "研发与资质" },
    "rd_institution": { "label": "研发机构等级", "type": "select", "group": "研发与资质",
